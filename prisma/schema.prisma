generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  passwordHash String
  role         String         @default("STUDENT") // STUDENT | TEACHER | ADMIN
  studentId    String?
  department   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     Session[]
  courses      Course[]       @relation("TeacherCourses")
  enrollments  Enrollment[]
  updates      CampusUpdate[]
  messages     ChatMessage[]
  auditLogs    AuditLog[]
  files        UploadedFile[]
  attendance   AttendanceRecord[]
  fees         FeeInvoice[]
  grades       GradeRecord[]
  hostel       HostelAllocation?
  assignments  AssignmentTask[]
  leaveApps    LeaveApplication[]

  @@index([role])
  @@index([studentId])
  @@index([department])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  ipHash    String?
  userAgent String?

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, expiresAt])
}

model Course {
  id          String         @id @default(cuid())
  code        String         @unique
  name        String
  description String?
  teacherId   String
  teacher     User           @relation("TeacherCourses", fields: [teacherId], references: [id])
  location    String
  building    String?
  room        String?
  schedule    String
  dayOfWeek   String?
  startTime   String?
  endTime     String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  enrollments Enrollment[]
  updates     CampusUpdate[]
  attendance  AttendanceRecord[]
  grades      GradeRecord[]
  materials   CourseMaterial[]
  questionPapers QuestionPaper[]
  makeupClasses  MakeupClass[]

  @@index([teacherId])
  @@index([code])
}

model CourseMaterial {
  id            String   @id @default(cuid())
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title         String
  fileName      String
  fileType      String
  storagePath   String?
  extractedText String?
  createdAt     DateTime @default(now())

  @@index([courseId])
}

model QuestionPaper {
  id            String   @id @default(cuid())
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title         String
  totalMarks    Int      @default(50)
  durationMins  Int      @default(60)
  difficulty    String   @default("Medium") // Easy | Medium | Hard
  questions     String   // JSON string of questions & solutions
  createdAt     DateTime @default(now())

  @@index([courseId])
}

model MakeupClass {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topic       String
  date        String
  timeSlot    String
  location    String
  reason      String?
  status      String   @default("SCHEDULED") // SCHEDULED | CANCELLED | COMPLETED
  createdAt   DateTime @default(now())

  @@index([courseId])
  @@index([date])
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model CampusUpdate {
  id        String   @id @default(cuid())
  courseId  String?
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  type      String
  title     String
  body      String
  location  String?
  building  String?
  room      String?
  metadata  String?
  expiresAt DateTime?
  createdAt DateTime @default(now())

  @@index([courseId])
  @@index([authorId])
  @@index([createdAt])
  @@index([type])
  @@index([courseId, createdAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  content   String
  intent    String?
  metadata  String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([userId, role, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  resource  String
  detail    String?
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([action, createdAt])
  @@index([resource, createdAt])
}

model UploadedFile {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename      String
  mimeType      String
  size          Int
  kind          String   // document | image | audio | other
  storagePath   String
  extractedText String?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

/// Mock University ERP — attendance
model AttendanceRecord {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  present        Int
  total          Int
  lastUpdatedAt  DateTime @default(now())

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

/// Mock University ERP — fee invoices / dues
model FeeInvoice {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  term        String
  category    String   // tuition | hostel | exam | other
  amountInr   Int
  paidInr     Int      @default(0)
  status      String   // PAID | DUE | PARTIAL | OVERDUE
  dueDate     DateTime
  createdAt   DateTime @default(now())

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([status, dueDate])
  @@index([term])
}

/// Mock University ERP — results / grades
model GradeRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  term      String
  grade     String
  marks     Float?
  credits   Int      @default(3)
  createdAt DateTime @default(now())

  @@unique([userId, courseId, term])
  @@index([userId])
  @@index([userId, term])
  @@index([courseId])
}

/// Mock University ERP — hostel allotment
model HostelAllocation {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  block     String
  room      String
  bed       String?
  warden    String?
  status    String   @default("ACTIVE") // ACTIVE | VACATED
  createdAt DateTime @default(now())

  @@index([block])
  @@index([status])
}

/// Mock University ERP — assignment submissions
model AssignmentTask {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseCode  String
  title       String
  dueDate     DateTime
  status      String    @default("PENDING") // PENDING | SUBMITTED | LATE
  submittedAt DateTime?
  fileName    String?
  createdAt   DateTime  @default(now())

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([courseCode])
  @@index([status, dueDate])
}

/// Mock University ERP — leave applications
model LeaveApplication {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveType  String    // sick | casual | emergency | home
  fromDate   DateTime
  toDate     DateTime
  reason     String
  status     String    @default("PENDING") // PENDING | APPROVED | REJECTED
  appliedAt  DateTime  @default(now())
  reviewedAt DateTime?

  @@index([userId, status])
  @@index([status, appliedAt])
  @@index([fromDate, toDate])
}

/// Public knowledge — campus buildings
model Building {
  id          String   @id @default(cuid())
  name        String
  block       String?
  description String?
  facilities  String?  // JSON array
  lat         Float?
  lng         Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([block])
  @@index([name])
}

/// Public knowledge — faculty directory
model FacultyMember {
  id             String   @id @default(cuid())
  name           String
  department     String?
  designation    String?
  email          String?
  specialization String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([department])
  @@index([name])
}

/// Public knowledge — campus events
model CampusEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime
  time        String?
  location    String?
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([category, date])
}

/// Public knowledge — notices
model Notice {
  id        String   @id @default(cuid())
  title     String
  body      String
  category  String?
  priority  String   @default("normal") // low | normal | high | urgent
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([priority, createdAt])
}

/// Public knowledge — clubs
model Club {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String?
  contact     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

/// RAG — indexed documents
model Document {
  id        String   @id @default(cuid())
  title     String
  category  String?
  source    String?
  mimeType  String?
  status    String   @default("indexed") // pending | indexed | failed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chunks    Chunk[]

  @@index([category])
  @@index([status])
}

/// RAG — document chunks
model Chunk {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    String
  index      Int
  tokenCount Int?
  createdAt  DateTime @default(now())

  @@index([documentId])
  @@index([documentId, index])
}

/// RAG — embedding metadata (vectors stored in file index for MVP)
model EmbeddingMeta {
  id         String   @id @default(cuid())
  chunkId    String?
  documentId String?
  model      String
  dimensions Int?
  createdAt  DateTime @default(now())

  @@index([documentId])
  @@index([chunkId])
}

/// Chat sessions for history
model ChatSession {
  id        String   @id @default(cuid())
  userId    String?
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  SessionMessage[]

  @@index([userId])
  @@index([userId, updatedAt])
}

model SessionMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  blocks    String?     // JSON UI blocks
  intent    String?
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
  @@index([createdAt])
}

/// Future integration registry
model FutureIntegration {
  id        String   @id @default(cuid())
  name      String   @unique // UMS | ERP | LIBRARY | TRANSPORT
  status    String   @default("planned") // planned | active | disabled
  config    String?  // JSON config
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
