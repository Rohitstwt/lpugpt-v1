DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-long-random-secret"
NEXT_PUBLIC_APP_NAME="LPUGPT"

# Temporary Vercel demo mode: clones prisma/dev.db to a function's /tmp disk.
# It is intentionally non-persistent; do not use this for a real deployment.
# DEMO_SQLITE_ON_VERCEL=1

# LLM priority: OpenAI → Groq → local Ollama
# For LPUGPT campus chat, Groq is the recommended free/fast cloud option.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Get a key: https://console.groq.com/keys

# Optional overrides
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Maps: OpenStreetMap + OSRM (free, no key). Optional Google override unused by default.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_API_KEY=

OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"
OLLAMA_MODEL="llama3.2:latest"
EMBED_MODEL="nomic-embed-text"
