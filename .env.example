# Copy to .env and fill in values: cp .env.example .env

# PostgreSQL — required. Local: npm run db:up then use URLs below.
# Production: Neon / Supabase / RDS (set DATABASE_PGBOUNCER=1 with pooler).
DATABASE_URL="postgresql://lpugpt:lpugpt@localhost:5432/lpugpt?schema=public"
DIRECT_DATABASE_URL="postgresql://lpugpt:lpugpt@localhost:5432/lpugpt?schema=public"
# Optional pool tuning (per Next.js server instance)
# DATABASE_POOL_SIZE=20
# DATABASE_POOL_TIMEOUT=30
# Set to 1 when using PgBouncer / Neon pooler in transaction mode
# DATABASE_PGBOUNCER=1

AUTH_SECRET="replace-with-long-random-secret"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="LPUGPT"

# LLM priority: OpenAI → Groq → local Ollama
# For LPUGPT campus chat, Groq is the recommended free/fast cloud option.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Get a key: https://console.groq.com/keys

# Optional overrides
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Maps: OpenStreetMap + OSRM (free, no key). Optional Google override unused by default.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_API_KEY=

OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"
OLLAMA_MODEL="llama3.2:latest"
EMBED_MODEL="nomic-embed-text"

# Mobile app (Expo) — see mobile/README.md
# EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:3000

# Bulk load test: npm run db:scale-seed -- 1000
# SCALE_SEED_PASSWORD=Student123!
